# Copy to .env (docker compose reads it automatically; `make run` loads it for go run).

# --- OpenRouter (required: text AI, video generation, AI editor, chat) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Model for the video-editing agent (writes Python); defaults to OPENROUTER_MODEL
EDITOR_MODEL=
# Cheapest suitable 9:16 model at the time of writing ($0.02/s at 480p, image-to-video supported).
# See GET /api/video-models for the live, price-sorted list.
VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
VIDEO_RESOLUTION=480p
VIDEO_ASPECT_RATIO=9:16

# --- Postgres (docker-compose) ---
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
CORS_ORIGINS=*
SCRAPER_ENABLED=true
TRENDS_ENABLED=true
CACHE_TTL=24h

# --- Only for `make run` (API via go run; docker-compose sets its own values) ---
DATABASE_URL=postgres://hackathon:hackathon@localhost:5432/hackathon?sslmode=disable
WORKER_URL=http://localhost:8001
MEDIA_DIR=data/media
