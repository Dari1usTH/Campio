# Copy to .env. Values in this file are examples, never live credentials.
APP_ENV=development
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api
APP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Required in production: at least 32 random bytes (openssl rand -hex 32).
# Sessions use opaque server-side tokens in httpOnly cookies, not browser JWTs.
SESSION_SECRET=

# Compose constructs the internal DATABASE_URL from these values.
# Percent-encode special characters if you supply a PostgreSQL URL yourself.
POSTGRES_USER=campio
POSTGRES_PASSWORD=campio-local-only
POSTGRES_DB=campio
POSTGRES_PORT=5432
# Host Go process / scripts/start. Inside Docker this is overridden to db:5432.
DATABASE_URL=postgres://campio:campio-local-only@localhost:5432/campio?sslmode=disable

# AI: no configured provider automatically enables logged server MOCK_AI mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_AI=false
# Optional existing provider (also required for native video/chat/editor features).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_URL=https://openrouter.ai/api/v1

# Development email is captured by Mailpit at http://localhost:8025.
# Replace ALL SMTP values for public deployment.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='Campio <hello@campio.local>'
SMTP_LOCAL_PORT=1025
MAILPIT_PORT=8025

# Google OAuth redirect URI: APP_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra web sources, opt-in (best effort; each is skipped when blocked or down).
# Amazon: one search page, skipped if Amazon shows a bot challenge.
# Reddit: Arctic Shift archive API, in subreddits chosen by the intake.
AMAZON_ENABLED=false
AMAZON_DOMAIN=www.amazon.de
REDDIT_ENABLED=false
BETALIST_ENABLED=false

# Explicit opt-in only. Disable test users before accepting real customers.
SEED_TEST_USER=false
TEST_USER_EMAIL=test@campio.app
# Leave empty to generate a strong password printed ONLY on first creation.
TEST_USER_PASSWORD=
TEST_USER_OTP=123456
# Fixed OTP allowed ONLY for the seeded account when APP_ENV != production
# OR explicitly enabled here. Keep false in production.
ALLOW_TEST_OTP=false

# Optional live data / existing video pipeline. Costs and network access apply.
SCRAPER_ENABLED=false
TRENDS_ENABLED=false
CACHE_TTL=24h
VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
VIDEO_RESOLUTION=480p
VIDEO_ASPECT_RATIO=9:16
EDITOR_MODEL=
WORKER_URL=http://localhost:8001
MEDIA_DIR=data/media
SEED_DIR=Backend/seed
FRONTEND_DIST=Frontend/dist

# HTTPS overlay only; set your actual domain and certificate contact.
DOMAIN=
ACME_EMAIL=

# Hot reload scripts/dev overrides these defaults separately from production.
DEV_APP_URL=http://localhost:5173
DEV_CORS_ORIGINS=http://localhost:5173
DEV_SMTP_HOST=127.0.0.1
